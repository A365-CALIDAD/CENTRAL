# Excel de entrada: pueden contener datos de clientes. No se versionan.
etl/entrada/*
!etl/entrada/.gitkeep

__pycache__/
*.pyc
.venv/
venv/
.env
~$*
*.log
.DS_Store
Thumbs.db
.claude/

# Contraseñas de los perfiles: solo en este PC
config/perfiles.local.json

# Datos en claro: solo en este PC. Lo publicado son los paquetes cifrados de data/seguro/
data/consolidado.json
data/seguimiento.json
data/historico/
data/cargas/
data/chatbot/

# Avisos por correo: destinatarios, estado de envíos y vistas previas (solo en este PC)
config/avisos.local.json
data/avisos/

# Ejecutable generado (se copia a mano a otros PC)
CalidadA365.exe

# Bitácora en línea: URL y claves de acceso, y el código generado para Apps Script (solo en este PC)
config/bitacora.local.json
bitacora/
